+TEST_CASE("rpc server warns at startup when scantxoutset is on beyond loopback", "[rpc scan]") {
+    constexpr auto warning = "rpc.scantxoutset is on and the JSON-RPC server listens on";
+
+    auto const wide = serve_once("rpc_scan_warn_wide", "0.0.0.0", true, {"100.64.0.7"});
+    CHECK(std::ranges::count_if(wide.first, [warning](std::string const& line) {
+        return line.find(warning) != std::string::npos;
+    }) == 1);
+    CHECK(holds(wide.first, "rpc.scantxoutset_caller (100.64.0.7)"));
+    // Loopback is answered.
+    CHECK(wide.second == rpc::build_success("1", "null") + "\n");
+
+    auto const local = serve_once("rpc_scan_warn_local", "127.0.0.1", true, {});
+    CHECK_FALSE(holds(local.first, warning));
+    CHECK(local.second == rpc::build_success("1", "null") + "\n");
+
+    auto const off = serve_once("rpc_scan_warn_off", "0.0.0.0", false, {});
+    CHECK_FALSE(holds(off.first, warning));
+    CHECK(off.second == rpc::build_error("1", -32601,
+        "scantxoutset is off on this node; the node operator turns it on with rpc.scantxoutset = true") + "\n");
+}
+
+TEST_CASE("wipe zeroes, and a writer sized for its document does not grow", "[rpc scan]") {
+    std::string text = "what a caller looks for";
+    auto* const data = text.data();
+    auto const size = text.size();
+    rpc::wipe(text);
+    CHECK(text.empty());
+    CHECK(std::all_of(data, data + size, [](char c) { return c == '\0'; }));
+
+    rpc::wiped_bytes bytes{1, 2, 3};
+    rpc::wipe(bytes);
+    CHECK(bytes.empty());
+
+    // An escaped string asks for six bytes a character before it is written.
+    rpc::writer sized(512);
+    sized.begin_object();
+    sized.field("txid", std::string(64, 'a'));
+    sized.end_object();
+    CHECK_FALSE(sized.grown());
+    auto const document = sized.str();
+    sized.wipe();
+    CHECK(document.size() == 75);
+
+    rpc::writer small(8);
+    small.begin_object();
+    small.field("txid", std::string(64, 'a'));
+    small.end_object();
+    CHECK(small.grown());
+
+    // The envelope of a sensitive answer is built without growing its buffer.
+    auto const result = std::string(R"({"a":")") + std::string(5000, 'b') + R"("})";
+    CHECK(rpc::build_success("7", result, true) == rpc::build_success("7", result));
+}
