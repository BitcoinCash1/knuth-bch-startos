+// ---- the service ------------------------------------------------------------------
+
+scan_service::scan_service(scan_access access)
+    : access_(std::move(access)) {}
+
+scan_service::~scan_service() {
+    if (current_) {
+        current_->abort.store(true, std::memory_order_relaxed);
+    }
+    if (walker_.joinable()) {
+        walker_.request_stop();
+        walker_.join();
+    }
+}
+
+scan_access const& scan_service::access() const noexcept {
+    return access_;
+}
+
+std::shared_ptr<scan_run> const& scan_service::current() const noexcept {
+    return current_;
+}
+
+void scan_service::start(blockchain::block_chain const& chain, std::shared_ptr<scan_run> run) {
+    if (walker_.joinable()) {
+        walker_.join();
+    }
+    current_ = run;
+    walker_ = std::jthread([&chain, run = std::move(run)](std::stop_token stop) {
+        run_scan(chain, *run, std::move(stop));
+    });
+}
+
+void scan_service::finish() noexcept {
+    if (walker_.joinable()) {
+        walker_.join();
+    }
+    current_.reset();
+}
+
+// ---- the method -------------------------------------------------------------------
+
+// scantxoutset "action" ( [scanobjects,...] ) -> as BCHN 29.1.0: "start" scans
+// the UTXO set for the scan objects, "status" the progress of the running
+// scan in %, "abort" stops it. One scan at a time. A scan object is
+// addr(<address>), raw(<hex script>) or tok(<category>), or {"desc": that,
+// "range": n}. The answer: success, searched_items, the unspents (txid, vout,
+// scriptPubKey, amount, height and tokenData) in outpoint order, total_amount,
+// and token_total_amounts when any token amounts were found.
+// C-API counterpart: none; the C-API has no walk of the UTXO set.
+::asio::awaitable<std::expected<std::string, rpc_error>>
+scan_tx_out_set(method_context& ctx, request const& req) {
+    // Refused before the parameters are read, on or off: a caller the node
+    // does not answer learns nothing from how its request would have been read.
+    if (ctx.scans == nullptr || ! ctx.scans->access().enabled) {
+        co_return kth::fail(make_error(error_code::method_not_found, std::string(off_message)));
+    }
+    if ( ! scan_caller_allowed(ctx.scans->access(), ctx.peer)) {
+        co_return kth::fail(make_error(error_code::method_not_found, std::string(caller_message)));
+    }
+    auto& scans = *ctx.scans;
+
+    auto params = read_params(req.params);
+    if (params.error) {
+        co_return kth::fail(std::move(*params.error));
+    }
+
+    if (params.action == "status") {
+        if ( ! scans.current()) {
+            co_return std::string("null");
+        }
+        writer w;
+        w.begin_object();
+        w.field("progress", int64_t(scans.current()->progress.load(std::memory_order_relaxed)));
+        w.end_object();
+        co_return w.str();
+    }
+
+    if (params.action == "abort") {
+        if ( ! scans.current()) {
+            co_return std::string("false");
+        }
+        scans.current()->abort.store(true, std::memory_order_relaxed);
+        co_return std::string("true");
+    }
+
+    if (params.action != "start") {
+        co_return kth::fail(make_error(error_code::invalid_parameter, "Invalid command"));
+    }
+
+    if (scans.current()) {
+        co_return kth::fail(make_error(error_code::invalid_parameter,
+            "Scan already in progress, use action \"abort\" or \"status\""));
+    }
+    if ( ! params.has_objects) {
+        co_return kth::fail(make_error(error_code::misc_error,
+            "JSON value is not an array as expected"));
+    }
+    if (params.too_many) {
+        co_return kth::fail(make_error(error_code::invalid_parameter, fmt::format(
+            "Too many scan objects: a scan takes at most {}", max_scan_objects)));
+    }
+
+#if defined(KTH_UTXOZ_REFERENCE_MODE)
+    co_return kth::fail(make_error(error_code::method_not_found,
+        "scantxoutset needs a build without the option utxoz_reference, whose UTXO set "
+        "holds no outputs to read"));
+#endif
+    auto const view = ctx.chain.chain_view();
+    if ( ! view || ! view->state) {
+        co_return kth::fail(make_error(error_code::internal_error, "chain state unavailable"));
+    }
+
+    auto run = std::make_shared<scan_run>();
+    for (size_t position = 0; position < params.objects.size(); ++position) {
+        auto& object = params.objects[position];
+        if (object.error) {
+            co_return kth::fail(std::move(*object.error));
+        }
+        if (auto error = add_scan_object(position, object.text, view->state->network(), *run)) {
+            co_return kth::fail(std::move(*error));
+        }
+        wipe(object.text);
+    }
+    auto const objects = params.objects.size();
+    auto const started = std::chrono::steady_clock::now();
+
+    scans.start(ctx.chain, run);
+
+    // Until the walk rings. A connection that goes, or can no longer be
+    // watched, aborts the scan: nobody reads its answer. The walk is still
+    // waited for, so the thread is joined when it has already finished.
+    {
+        using namespace ::asio::experimental;
+        auto const executor = co_await ::asio::this_coro::executor;
+        doorbell silent{1};
+        doorbell* watched = ctx.closed != nullptr ? ctx.closed : &silent;
+        channel_select_options options;
+        options.biased = true;
+        for (;;) {
+            auto completion = co_await make_select(receive(run->done), receive(*watched))
+                .async_wait(executor, options, std::stop_token{}, ::asio::as_tuple(::asio::deferred));
+            auto const& [ec, selected] = completion;
+            if ( ! ec && selected.index == 0) {
+                break;
+            }
+            run->abort.store(true, std::memory_order_relaxed);
+            watched = &silent;
+        }
+    }
+    scans.finish();
+
+    // Counts only: what was looked for and what was found are not logged.
+    spdlog::debug("[rpc] scantxoutset: {} scan object(s), {} entries searched in {} pass(es), "
+        "{} unspent(s), {} ms", objects, run->searched, run->passes, run->matches.size(),
+        std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now() - started).count());
+
+    switch (run->ending) {
+        case scan_run::end::complete:
+        case scan_run::end::aborted:
+            co_return std::move(run->answer);
+        case scan_run::end::too_large:
+            co_return kth::fail(make_error(error_code::invalid_parameter, fmt::format(
+                "Scan found more than an answer of {} MiB holds; scan for fewer outputs",
+                max_scan_answer_size / (1024 * 1024))));
+        case scan_run::end::unreadable:
+            break;
+    }
+    co_return kth::fail(make_error(error_code::internal_error, "the UTXO set could not be read"));
+}
+
