+// One 20-byte hash, 4423cfd2...0fc3, paid to by P2PKH and P2SH, and the
+// 32-byte hash 000102...1f by P2SH32, as in the validateaddress tests.
+constexpr std::string_view pkh_script = "76a9144423cfd20e8f5f10863ae31df5634620d36b0fc388ac";
+constexpr std::string_view sh_script = "a9144423cfd20e8f5f10863ae31df5634620d36b0fc387";
+constexpr std::string_view sh32_script =
+    "aa20000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f87";
+// Another P2PKH output, and one anyone can spend.
+constexpr std::string_view other_script = "76a914000000000000000000000000000000000000000188ac";
+constexpr std::string_view true_script = "51";
+
+hash_digest filled(uint8_t byte) {
+    hash_digest hash{};
+    hash.fill(byte);
+    return hash;
+}
+
+// Two token categories. Display order is reversed byte order, so a category
+// whose bytes are all the same reads the same both ways.
+hash_digest const category_a = filled(0xa1);
+hash_digest const category_b = filled(0xb2);
+
+data_chunk bytes_of(std::string_view hex) {
+    auto bytes = decode_base16(hex);
+    REQUIRE(bytes);
+    return *bytes;
+}
+
+domain::chain::output output_of(uint64_t value, std::string_view script_hex,
+                                domain::chain::token_data_opt token = std::nullopt) {
+    return domain::chain::output{value, domain::chain::script{bytes_of(script_hex), false}, std::move(token)};
+}
+
+struct unspent {
+    hash_digest txid;
+    uint32_t index;
+    domain::chain::output output;
+    uint32_t height;
+};
+
+utxoz::raw_outpoint key_of(hash_digest const& txid, uint32_t index) {
+    return utxoz::make_outpoint(std::span<uint8_t const, 32>{txid.data(), 32}, index);
+}
+
+// Put the outputs into the UTXO set through the helper a connect batch uses,
+// in one window, as the node stores them.
+void store(blockchain::block_chain& chain, std::vector<unspent> const& unspents) {
+    blockchain::utxo_raw_delta delta;
+    uint32_t top = 1;
+    for (auto const& u : unspents) {
+        database::utxo_entry const entry{u.output, u.height, u.height, false};
+        auto const bytes = entry.to_data();
+        delta.inserts.emplace(key_of(u.txid, u.index),
+            blockchain::utxo_raw_value{std::span<uint8_t const>(bytes), u.height});
+        top = std::max(top, u.height);
+    }
+    auto window = chain.begin_utxo_write();
+    REQUIRE(window);
+    window->mark_mutating();
+    REQUIRE(blockchain::apply_utxo_delta(chain, *window, delta, top).ok());
+    window->complete();
+}
+
+// The set the scans below look through: plain outputs, a covenant holding a
+// mutable NFT (how PHOTON keeps its mining state), and each kind of token.
+std::vector<unspent> sample_set() {
+    using namespace domain::chain;
+    return {
+        {filled(0x11), 0, output_of(10000, pkh_script), 3},
+        {filled(0x22), 1, output_of(20000, sh_script), 4},
+        {filled(0x33), 0, output_of(1000, sh32_script,
+            make_non_fungible(category_a, capability_t::mut, bytes_of("beef"))), 5},
+        {filled(0x44), 2, output_of(800, pkh_script, make_fungible(category_a, 1000)), 6},
+        {filled(0x55), 0, output_of(800, other_script,
+            make_non_fungible(category_b, capability_t::minting, {})), 7},
+        {filled(0x66), 3, output_of(800, other_script,
+            make_both(category_b, 5, capability_t::none, bytes_of("00"))), 8},
+        {filled(0x77), 0, output_of(5000, true_script), 9},
+    };
+}
+
+std::string const display_a = encode_hash(category_a);
+std::string const display_b = encode_hash(category_b);
+
+// The unspents of the sample set as the answer shows them.
+std::string const unspent_11 = fmt::format(
+    R"({{"txid":"{}","vout":0,"scriptPubKey":"{}","amount":0.0001,"height":3}})",
+    encode_hash(filled(0x11)), pkh_script);
+std::string const unspent_22 = fmt::format(
+    R"({{"txid":"{}","vout":1,"scriptPubKey":"{}","amount":0.0002,"height":4}})",
+    encode_hash(filled(0x22)), sh_script);
+std::string const unspent_33 = fmt::format(
+    R"({{"txid":"{}","vout":0,"scriptPubKey":"{}","amount":0.00001,"height":5,)"
+    R"("tokenData":{{"category":"{}","amount":"0","nft":{{"capability":"mutable","commitment":"beef"}}}}}})",
+    encode_hash(filled(0x33)), sh32_script, display_a);
+std::string const unspent_44 = fmt::format(
+    R"({{"txid":"{}","vout":2,"scriptPubKey":"{}","amount":0.000008,"height":6,)"
+    R"("tokenData":{{"category":"{}","amount":"1000"}}}})",
+    encode_hash(filled(0x44)), pkh_script, display_a);
+std::string const unspent_55 = fmt::format(
