new file mode 100644
index 00000000..84779796
--- /dev/null
+++ b/src/node/include/kth/node/rpc/wipe.hpp
@@ -0,0 +1,73 @@
+// Copyright (c) 2016-present Knuth Project developers.
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef KTH_NODE_RPC_WIPE_HPP
+#define KTH_NODE_RPC_WIPE_HPP
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace kth::node::rpc {
+
+// Zero `size` bytes at `data` in a way the compiler keeps, although the memory
+// is about to be freed and nothing reads it again. scantxoutset wipes with this
+// what a caller looked for and what was found for it, once it is answered.
+void wipe(void* data, size_t size) noexcept;
+
+// Zero a string's characters, then empty it. Inline storage included: data()
+// is the characters wherever they are kept.
+template <typename Char, typename Traits, typename Allocator>
+void wipe(std::basic_string<Char, Traits, Allocator>& text) noexcept {
+    wipe(text.data(), text.size() * sizeof(Char));
+    text.clear();
+}
+
+// Zero a vector's elements, then empty it.
+template <typename T, typename Allocator>
+    requires std::is_trivially_copyable_v<T>
+void wipe(std::vector<T, Allocator>& items) noexcept {
+    wipe(items.data(), items.size() * sizeof(T));
+    items.clear();
+}
+
+// An allocator that zeroes what it gives back. A container that grows frees
+// the buffer it outgrew, with a copy of its contents; with this one that copy
+// is zeroed first. Elements are destroyed before their storage is given back,
+// so what is zeroed is storage, never a live object.
+template <typename T>
+struct wiping_allocator {
+    using value_type = T;
+
+    wiping_allocator() noexcept = default;
+
+    template <typename U>
+    wiping_allocator(wiping_allocator<U> const&) noexcept {}
+
+    [[nodiscard]] T* allocate(size_t count) {
+        return std::allocator<T>{}.allocate(count);
+    }
+
+    void deallocate(T* items, size_t count) noexcept {
+        wipe(items, count * sizeof(T));
+        std::allocator<T>{}.deallocate(items, count);
+    }
+
+    template <typename U>
+    friend bool operator==(wiping_allocator const&, wiping_allocator<U> const&) noexcept {
+        return true;
+    }
+};
+
+// Bytes and text that are zeroed when freed, including each buffer left
+// behind as they grow.
+using wiped_bytes = std::vector<uint8_t, wiping_allocator<uint8_t>>;
+using wiped_string = std::basic_string<char, std::char_traits<char>, wiping_allocator<char>>;
+
+} // namespace kth::node::rpc
+
+#endif // KTH_NODE_RPC_WIPE_HPP
