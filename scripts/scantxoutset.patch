+// Copyright (c) 2016-present Knuth Project developers.
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <kth/node/rpc/wipe.hpp>
+
+#include <cstring>
+
+namespace kth::node::rpc {
+
+void wipe(void* data, size_t size) noexcept {
+    if (data == nullptr || size == 0) {
+        return;
+    }
+#if defined(__GNUC__) || defined(__clang__)
+    std::memset(data, 0, size);
+    // The stores are dead to the optimizer, which may drop a memset of memory
+    // that is freed next. An empty asm that may read all memory through `data`
+    // keeps them, with link-time optimization too.
+    __asm__ __volatile__("" : : "r"(data) : "memory");
+#else
+    // Volatile stores are never dropped.
+    auto* bytes = static_cast<unsigned char volatile*>(data);
+    while (size-- != 0) {
+        *bytes++ = 0;
+    }
+#endif
+}
+
+} // namespace kth::node::rpc
