+#include <kth/node/rpc/json.hpp>
+#include <kth/node/settings.hpp>
+
+namespace kth::blockchain {
+struct block_chain;
+} // namespace kth::blockchain
+
+namespace kth::node::rpc {
+
+struct method_context;
+
+// scantxoutset: the unspent outputs of the UTXO set whose locking bytecode, or
+// whose token category, a caller names. One walk of the set, with no index.
+//
+// The caller names what it looks for, so the call is for clients the operator
+// runs against this node, and it is built so that it cannot become a way for a
+// wallet to tell another person's node what it watches:
+//
+//   - JSON-RPC only, behind the RPC credentials. Off unless turned on with
+//     rpc.scantxoutset.
+//   - Even on, it answers callers on loopback, and each address the operator
+//     names in rpc.scantxoutset_caller; every other caller is refused before
+//     its parameters are read.
+//   - What a caller looked for and what was found for it are logged at no
+//     level and named in no error; an error says which scan object it is
+//     about by its position. They are zeroed once the answer is written, or
+//     the scan aborted or failed, wherever the server held them.
+//   - One scan at a time, of at most max_scan_objects objects, with an answer
+//     of at most max_scan_answer_size bytes.
+//
+// The walk takes a read lease and gives way to block connection: see
+// block_chain::utxo_walk_entries.
+
+// Scan objects one start takes. BCHN takes any number, each up to a
+// million scripts for a ranged descriptor and a thousand by default; kth takes
+// no ranged descriptors, and a thousand objects is that default as addr()
+// objects. Pickaxe sends one.
+inline constexpr size_t max_scan_objects = 1000;
+
+// The longest raw() script: the longest locking bytecode a spendable output
+// has (MAX_SCRIPT_SIZE). BCHN keeps no longer one in its UTXO set.
+inline constexpr size_t max_raw_script_size = 10000;
+
+// The largest answer a scan gives, counted as an upper bound of its rendered
+// size as outputs are found. A scan that finds more ends with an error, so a
+// broad scan cannot make the node hold an answer of any size.
+inline constexpr size_t max_scan_answer_size = 32u * 1024u * 1024u;
+
+// Who may call scantxoutset, as the server holds it.
+struct scan_access {
+    bool enabled = false;
+    // Besides loopback, each normalized as scantxoutset_caller_address().
+    std::vector<::asio::ip::address> callers;
+};
+
+// The access rpc_settings give. A caller entry that is not one address (one
+// the option parser would have refused) turns scantxoutset off, with an error
+// in the log that names the setting.
+[[nodiscard]]
+scan_access make_scan_access(rpc_settings const& settings);
+
+// Whether `peer` may call scantxoutset: a loopback address, or one of the
+// callers. A request whose peer is unknown is refused.
+[[nodiscard]]
+bool scan_caller_allowed(scan_access const& access, std::optional<::asio::ip::address> const& peer);
+
+// The locking bytecode an address pays to: P2PKH, P2SH or P2SH32, the same for
+// its token-aware form. A cashaddr of `net`, with or without its prefix, or a
+// legacy address of `net`. Written to `script`, of the longest such script,
+// and nothing is allocated, so a caller can wipe every copy; the bytes
+// written, or nullopt for anything that is not such an address.
+inline constexpr size_t max_address_script_size = 35;
+[[nodiscard]]
+std::optional<size_t> address_output_script(std::string_view address, domain::config::network net,
+    std::span<uint8_t, max_address_script_size> script) noexcept;
+
+struct scan_run;
+
+// The one scan the server runs at a time. Its state is used on the server's
+// strand only; the walk runs on a thread of its own, which the scan's
+// handler joins before it answers, and the destructor joins at shutdown.
+class scan_service {
+public:
+    explicit scan_service(scan_access access);
+    ~scan_service();
+
+    scan_service(scan_service const&) = delete;
+    scan_service& operator=(scan_service const&) = delete;
+
+    [[nodiscard]] scan_access const& access() const noexcept;
+
+    // The running scan, null when none runs.
+    [[nodiscard]] std::shared_ptr<scan_run> const& current() const noexcept;
+
+    // Start the walk of `run` on a thread of its own. The caller has checked
+    // that no scan runs.
+    void start(blockchain::block_chain const& chain, std::shared_ptr<scan_run> run);
+
+    // Join the walk of the running scan, which has ended or is ending, and
+    // forget it.
+    void finish() noexcept;
+
+private:
+    scan_access access_;
+    std::shared_ptr<scan_run> current_;
+    std::jthread walker_;
+};
+
+// scantxoutset "action" ( [scanobjects,...] )
+::asio::awaitable<std::expected<std::string, rpc_error>>
+scan_tx_out_set(method_context& ctx, request const& req);
+
+} // namespace kth::node::rpc
+
+#endif // KTH_NODE_RPC_SCAN_HPP
