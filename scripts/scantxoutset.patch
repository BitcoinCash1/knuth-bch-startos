+TEST_CASE("scantxoutset finds outputs by raw script, address and token category", "[rpc scan]") {
+    scan_fixture f("rpc_scan_find");
+    REQUIRE(f.start());
+    store(f.chain.chain(), sample_set());
+    auto const searched = f.set_size();
+
+    // The locking bytecode, with or without tokens in front of it.
+    CHECK(f.scan(fmt::format(R"(["raw({})"])", pkh_script)) ==
+        answer(searched, {unspent_11, unspent_44}, "0.000108", fmt::format(R"("{}":"1000")", display_a)));
+
+    // The covenant holding the mutable NFT, found by its bytecode alone.
+    CHECK(f.scan(fmt::format(R"(["raw({})"])", sh32_script)) ==
+        answer(searched, {unspent_33}, "0.00001"));
+
+    // Upper case hex, and the object form with a range BCHN checks and ignores.
+    std::string upper(sh_script);
+    std::ranges::transform(upper, upper.begin(), [](char c) { return char(std::toupper(c)); });
+    CHECK(f.scan(fmt::format(R"([{{"desc":"raw({})","range":5}}])", upper)) ==
+        answer(searched, {unspent_22}, "0.0002"));
+
+    // Each token category, NFTs included; a fungible total only where there
+    // are fungible amounts.
+    CHECK(f.scan(fmt::format(R"(["tok({})"])", display_a)) ==
+        answer(searched, {unspent_33, unspent_44}, "0.000018", fmt::format(R"("{}":"1000")", display_a)));
+    CHECK(f.scan(fmt::format(R"(["tok({})"])", display_b)) ==
+        answer(searched, {unspent_55, unspent_66}, "0.000016", fmt::format(R"("{}":"5")", display_b)));
+
+    // Several objects in one scan, in outpoint order, each output once.
+    CHECK(f.scan(fmt::format(R"(["raw({})","tok({})","raw({})"])", sh_script, display_b, sh_script)) ==
+        answer(searched, {unspent_22, unspent_55, unspent_66}, "0.000216", fmt::format(R"("{}":"5")", display_b)));
+
+    // Nothing found.
+    CHECK(f.scan(R"(["raw(6a)"])") == answer(searched, {}, "0"));
+    CHECK(f.scan(R"([])") == answer(searched, {}, "0"));
+}
+
+TEST_CASE("scantxoutset takes addresses of each kind for the node's network", "[rpc scan]") {
+    scan_fixture f("rpc_scan_addresses");
+    REQUIRE(f.start());
+    store(f.chain.chain(), sample_set());
+    auto const searched = f.set_size();
+    using domain::config::network;
+
+    auto const hash20 = decode_base16<20>("4423cfd20e8f5f10863ae31df5634620d36b0fc3");
+    auto const hash32 = decode_base16<32>("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
+    REQUIRE(hash20);
+    REQUIRE(hash32);
+    auto const pkh = payment_address::from_shorthash(*hash20, payment_address::testnet_p2kh);
+    auto const sh = payment_address::from_shorthash(*hash20, payment_address::testnet_p2sh);
+    auto const sh32 = payment_address::from_hash(*hash32, payment_address::testnet_p2sh);
+    REQUIRE(pkh);
+    REQUIRE(sh);
+    REQUIRE(sh32);
+
+    auto const by_key = answer(searched, {unspent_11, unspent_44}, "0.000108",
+        fmt::format(R"("{}":"1000")", display_a));
+    auto const by_script = answer(searched, {unspent_22}, "0.0002");
+    auto const by_script32 = answer(searched, {unspent_33}, "0.00001");
+    auto const addr = [&f](std::string_view address) {
+        return f.scan(fmt::format(R"(["addr({})"])", address));
+    };
+
+    auto const plain = pkh->encoded_cashaddr(network::regtest, false);
+    CHECK(plain == "bchreg:qpzz8n7jp6847yyx8t33matrgcsdx6c0cv99t2zdvc");
+    CHECK(addr(plain) == by_key);
+    // Token-aware, without its prefix, in upper case, and legacy.
+    CHECK(addr(pkh->encoded_cashaddr(network::regtest, true)) == by_key);
