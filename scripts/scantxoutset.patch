diff --git a/src/blockchain/include/kth/blockchain/interface/block_chain.hpp b/src/blockchain/include/kth/blockchain/interface/block_chain.hpp
index 65d22e30..1f9ae397 100644
--- a/src/blockchain/include/kth/blockchain/interface/block_chain.hpp
+++ b/src/blockchain/include/kth/blockchain/interface/block_chain.hpp
@@ -665,6 +665,90 @@ struct KB_API block_chain {
             [&](auto const& db) { return db.for_each_utxo(std::forward<F>(callback)); });
     }
 
+    /// Whether a writer waits for the UTXO window. Read under the gate's
+    /// mutex, so it is exact when read and may be stale at once: for a long
+    /// reader deciding to step aside, never for granting anything.
+    [[nodiscard]] bool utxo_writer_waiting() const {
+        return utxo_gate_.writers_waiting() != 0;
+    }
+
+    /// How a walk of the UTXO set under a read lease ended.
+    enum class utxo_walk_end {
+        /// Every entry was visited, and nothing changed the set meanwhile.
+        complete,
+        /// A writer asked for the window and the walk stopped to let it in.
+        yielded,
+        /// The caller's stop() said to stop.
+        stopped,
+        /// The store refused the lease, or could not be walked in full.
+        unreadable,
+    };
+
+#ifndef KTH_UTXOZ_REFERENCE_MODE
+    /// Walk every UTXO with its stored entry under a READ LEASE, stepping aside
+    /// whenever a writer waits for the window.
+    ///
+    /// For a reader that walks the whole set and must not hold up block
+    /// connection (scantxoutset). utxo_for_each() walks under the window, so a
+    /// connect batch, every lookup and every other reader wait for the whole
+    /// walk. Here the lease excludes only the window, as any lease does, and
+    /// find() and resolve() go on alongside. They share nothing the walk reads
+    /// that either of them writes: find() writes only its own probe counters;
+    /// resolve() writes its resolution counters and reads older versions
+    /// through the file cache, under a lock of its own; the walk reads the
+    /// active containers as find() does and maps every older version itself,
+    /// outside the cache, and a version file holds no lock (UTXO-Z 2.2.0).
+    ///
+    /// Every `check_every` entries the walk asks the gate whether a writer
+    /// waits, and if one does it stops there and returns `yielded`. The lease
+    /// ends with the walk and the writer is admitted; a caller that walks again
+    /// waits in the gate behind it. So a block waits at most `check_every`
+    /// entries for a walk, and a walk that returns `complete` saw the set as it
+    /// stood between two windows, all of it at one connected tip. The count of
+    /// waiting writers is read under the gate's mutex, so it is exact when read;
+    /// a writer that starts waiting just after is seen at the next check.
+    ///
+    /// stop() is asked at the same points; true ends the walk with `stopped`.
+    ///
+    /// UTXO-Z offers no way to stop a walk early. A std::exception from the
+    /// callback is reported as a failed walk, so the walk is stopped with an
+    /// exception of a type of its own, which the store lets through and which
+    /// ends here. The version files the walk had open close as it unwinds.
+    template <typename Visit, typename Stop>
+    [[nodiscard]]
+    utxo_walk_end utxo_walk_entries(Visit&& visit, Stop&& stop, size_t check_every = 1024) const {
+        struct step_aside {};
+        auto lease = utxo_gate_.read();
+        if ( ! lease) {
+            return utxo_walk_end::unreadable;
+        }
+        auto ending = utxo_walk_end::complete;
+        size_t until_check = check_every;
+        auto entry = [&](utxoz::raw_outpoint const& key, uint32_t height,
+                         std::span<uint8_t const> stored) {
+            if (--until_check == 0) {
+                until_check = check_every;
+                if (stop()) {
+                    ending = utxo_walk_end::stopped;
+                    throw step_aside{};
+                }
+                if (utxo_writer_waiting()) {
+                    ending = utxo_walk_end::yielded;
+                    throw step_aside{};
+                }
+            }
+            visit(key, height, stored);
+        };
+        try {
+            auto const walked = utxoz_db_.with_read(*lease,
+                [&](auto const& db) { return db.for_each_entry(entry); });
+            return walked ? ending : utxo_walk_end::unreadable;
+        } catch (step_aside const&) {
+            return ending;
+        }
+    }
+#endif
+
     // UTXO-Z size (number of UTXOs in the set)
     [[nodiscard]]
     /// How many UTXOs the store holds.
diff --git a/src/database/include/kth/database/databases/utxoz_database.hpp b/src/database/include/kth/database/databases/utxoz_database.hpp
index ebf7363d..92884b8f 100644
--- a/src/database/include/kth/database/databases/utxoz_database.hpp
+++ b/src/database/include/kth/database/databases/utxoz_database.hpp
@@ -405,6 +405,40 @@ struct KD_API utxoz_database {
         return true;
     }
 
+#ifndef KTH_UTXOZ_REFERENCE_MODE
+    /// Iterate over every UTXO with what is stored for it: the key, the height
+    /// of the block that created it, and the stored bytes, which are those of a
+    /// utxo_entry (the wire output, then the height, the median time past and
+    /// the coinbase flag). Full mode only: a reference-mode entry is a place in
+    /// the block files, not the output.
+    ///
+    /// @param callback Callable with signature
+    ///        void(utxoz::raw_outpoint const&, uint32_t, std::span<uint8_t const>)
+    /// @return Same contract as for_each_utxo(): false if the store is closed or
+    ///         the walk could not read every version file it needed, and a
+    ///         partial walk is not reported through the callback.
+    ///
+    /// UTXO-Z reports a std::exception raised by the callback as a failed walk.
+    /// An exception of another type passes through it unchanged, and the
+    /// version files the walk had open are closed on the way out: that is how
+    /// block_chain::utxo_walk_entries() stops a walk early.
+    template <typename F>
+    [[nodiscard]]
+    bool for_each_entry(F&& callback) const {
+        if ( ! is_open()) {
+            return false;
+        }
+        auto const walked = db_->for_each_entry(std::forward<F>(callback));
+        if ( ! walked) {
+            spdlog::error("[utxoz_database] Walking the UTXO entries failed: {}; the walk stopped "
+                "where it failed and what it visited is a subset, not the set",
+                utxoz_error_name(walked.error()));
+            return false;
+        }
+        return true;
+    }
+#endif
