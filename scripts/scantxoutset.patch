+std::expected<::asio::ip::address, std::string_view>
+scantxoutset_caller_address(std::string_view text) {
+    std::error_code ec;
+    auto address = ::asio::ip::make_address(std::string(text), ec);
+    if (ec) {
+        return std::unexpected("is not an IP address; a host name, a range or a wildcard "
+            "is not taken, one address per entry is");
+    }
+    if (address.is_v6() && address.to_v6().is_v4_mapped()) {
+        address = ::asio::ip::make_address_v4(::asio::ip::v4_mapped, address.to_v6());
+    }
+    if (address.is_unspecified()) {
+        return std::unexpected("is the wildcard address, which stands for every caller");
+    }
+    if (address.is_multicast()) {
+        return std::unexpected("is a multicast address, not one caller");
+    }
+    if (address.is_v4() && address.to_v4() == ::asio::ip::address_v4::broadcast()) {
+        return std::unexpected("is the broadcast address, not one caller");
+    }
+    return address;
+}
