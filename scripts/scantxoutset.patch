+namespace kth::node::rpc {
+
+// One scan: what it looks for, its progress, and what it found. The handler
+// fills what it looks for; the walker thread fills the rest and rings `done`
+// when it has ended, after which the handler reads them. Every container
+// zeroes what it frees, so nothing of the scan is left behind when the last
+// owner drops it.
+struct scan_run {
+    enum class end {
+        complete,
+        aborted,
+        too_large,
+        unreadable,
+    };
+
+    // Byte strings hashed by content, so a locking bytecode read in place from
+    // the store is looked up without copying it.
+    struct bytes_hash {
+        using is_transparent = void;
+        size_t operator()(std::span<uint8_t const> bytes) const noexcept {
+            return std::hash<std::string_view>{}(std::string_view(
+                reinterpret_cast<char const*>(bytes.data()), bytes.size()));
+        }
+    };
+
+    struct bytes_equal {
+        using is_transparent = void;
+        bool operator()(std::span<uint8_t const> a, std::span<uint8_t const> b) const noexcept {
+            return std::ranges::equal(a, b);
+        }
+    };
+
+    // A category is a hash already: its first bytes are as good as any hash.
+    struct category_hash {
+        size_t operator()(hash_digest const& category) const noexcept {
+            size_t value;
+            std::memcpy(&value, category.data(), sizeof(value));
+            return value;
+        }
+    };
+
+    struct match {
+        utxoz::raw_outpoint key;
+        uint32_t height;
+        wiped_bytes stored;
+    };
+
+    boost::unordered_flat_set<wiped_bytes, bytes_hash, bytes_equal,
+        wiping_allocator<wiped_bytes>> scripts;
+    boost::unordered_flat_set<hash_digest, category_hash, std::equal_to<>,
+        wiping_allocator<hash_digest>> categories;
+
+    std::atomic<int> progress{0};
+    std::atomic<bool> abort{false};
+    doorbell done{1};
+
+    // The walker's, until `done` rings.
+    std::vector<match, wiping_allocator<match>> matches;
+    uint64_t searched = 0;
+    size_t passes = 1;
+    size_t answer_bound = 0;
+    size_t longest_text = 64;
+    bool too_large = false;
+    end ending = end::unreadable;
+    std::string answer;
+    bool answer_grown = false;
+
+    ~scan_run() {
+        wipe(answer);
+    }
+};
+
+namespace {
+
+// ---- parameters -------------------------------------------------------------
+
+constexpr std::string_view usage = "scantxoutset \"action\" ( [scanobjects,...] )";
+
+rpc_error type_error(std::string_view expected, simdjson::ondemand::json_type got) {
+    auto const name = [got] {
+        using enum simdjson::ondemand::json_type;
+        switch (got) {
+            case array: return "array";
+            case object: return "object";
+            case number: return "number";
+            case string: return "string";
+            case boolean: return "bool";
+            case null: return "null";
+            default: return "unknown";
+        }
+    }();
+    return make_error(error_code::type_error, fmt::format("Expected type {}, got {}", expected, name));
+}
+
+// A JSON string as its raw text, quotes included and maybe whitespace after,
+// unescaped into `out`. A \u escape outside ASCII becomes a byte no scan
+// object holds, so such text is an invalid descriptor, as it would be with
+// the character itself. Unescaped here rather than by the parser, which
+// would keep a copy in a buffer of its own.
+bool unescape_json_string(std::string_view raw, wiped_string& out) {
+    while ( ! raw.empty() && (raw.back() == ' ' || raw.back() == '\t' ||
+                              raw.back() == '\n' || raw.back() == '\r')) {
+        raw.remove_suffix(1);
+    }
+    if (raw.size() < 2 || raw.front() != '"' || raw.back() != '"') {
+        return false;
+    }
+    raw = raw.substr(1, raw.size() - 2);
+    out.reserve(raw.size());
+    for (size_t i = 0; i < raw.size(); ++i) {
+        auto const c = raw[i];
+        if (c != '\\') {
+            out.push_back(c);
+            continue;
+        }
+        if (++i == raw.size()) {
+            return false;
+        }
+        switch (raw[i]) {
+            case '"': out.push_back('"'); break;
+            case '\\': out.push_back('\\'); break;
+            case '/': out.push_back('/'); break;
+            case 'b': out.push_back('\b'); break;
+            case 'f': out.push_back('\f'); break;
+            case 'n': out.push_back('\n'); break;
+            case 'r': out.push_back('\r'); break;
+            case 't': out.push_back('\t'); break;
+            case 'u': {
+                if (i + 4 >= raw.size()) {
+                    return false;
+                }
+                uint32_t code = 0;
+                for (size_t k = 1; k <= 4; ++k) {
+                    auto const h = raw[i + k];
+                    uint32_t digit = 0;
+                    if (h >= '0' && h <= '9') digit = uint32_t(h - '0');
+                    else if (h >= 'a' && h <= 'f') digit = uint32_t(h - 'a' + 10);
+                    else if (h >= 'A' && h <= 'F') digit = uint32_t(h - 'A' + 10);
+                    else return false;
+                    code = code * 16 + digit;
+                }
+                i += 4;
+                out.push_back(code < 0x80 ? char(code) : char(0xff));
+                break;
+            }
+            default:
+                return false;
+        }
+    }
+    return true;
+}
+
+// One scan object as given: its descriptor, or the error BCHN gives for an
+// object of that shape.
+struct scan_object {
+    wiped_string text;
+    std::optional<rpc_error> error;
+};
+
+using scan_objects = std::vector<scan_object, wiping_allocator<scan_object>>;
+
+struct scan_params {
+    // An error in the parameters themselves, found before anything else.
+    std::optional<rpc_error> error;
+    std::string action;
+    bool has_objects = false;
+    bool too_many = false;
+    scan_objects objects;
+};
+
+// A {"desc": ..., "range": n} object, as BCHN reads it: the descriptor must be
+// a string, and a range, which only a ranged descriptor uses, an integer in
+// [0, 1000000].
+scan_object read_object(simdjson::ondemand::object object) {
+    scan_object out;
+    simdjson::ondemand::value desc;
+    simdjson::ondemand::json_type type{};
+    if (object.find_field_unordered("desc").get(desc) != simdjson::SUCCESS ||
+        desc.type().get(type) != simdjson::SUCCESS ||
+        type == simdjson::ondemand::json_type::null) {
+        out.error = make_error(error_code::invalid_parameter,
+            "Descriptor needs to be provided in scan object");
+        return out;
+    }
+    std::string_view raw;
+    if (type != simdjson::ondemand::json_type::string ||
+        desc.raw_json().get(raw) != simdjson::SUCCESS) {
+        out.error = make_error(error_code::misc_error, "JSON value is not a string as expected");
+        return out;
+    }
+    if ( ! unescape_json_string(raw, out.text)) {
+        // Read as an invalid descriptor; the text is wiped with the object.
+        wipe(out.text);
+        out.text.push_back('\xff');
+    }
+
+    simdjson::ondemand::value range;
+    if (object.find_field_unordered("range").get(range) == simdjson::SUCCESS &&
+        range.type().get(type) == simdjson::SUCCESS &&
+        type != simdjson::ondemand::json_type::null) {
+        int64_t value = 0;
+        if (type != simdjson::ondemand::json_type::number) {
+            out.error = make_error(error_code::misc_error, "JSON value is not an integer as expected");
+        } else if (range.get_int64().get(value) != simdjson::SUCCESS ||
+                   value < std::numeric_limits<int32_t>::min() ||
+                   value > std::numeric_limits<int32_t>::max()) {
+            out.error = make_error(error_code::misc_error, "JSON integer out of range");
+        } else if (value < 0 || value > 1000000) {
+            out.error = make_error(error_code::invalid_parameter, "range out of range");
+        }
+    }
+    return out;
+}
+
+// The parameters, read in one pass over a copy that is wiped. Every check
+// BCHN makes before it scans is answered here or by the caller, in BCHN's
+// order: the count, the types, the action, then each object in turn.
+scan_params read_params(std::string_view params_json) {
+    scan_params out;
+    auto const fail = [&out](rpc_error error) {
+        if ( ! out.error) {
+            out.error = std::move(error);
+        }
+    };
+
+    simdjson::padded_string padded(params_json.empty() ? std::string_view{"[]"} : params_json);
+    detail::scope_action wipe_copy([&padded]() noexcept {
+        wipe(padded.data(), padded.size());
+    }, true);
+    simdjson::ondemand::parser parser;
+    simdjson::ondemand::document doc;
+    simdjson::ondemand::array params;
+    if (parser.iterate(padded).get(doc) != simdjson::SUCCESS ||
+        doc.get_array().get(params) != simdjson::SUCCESS) {
+        fail(make_error(error_code::misc_error, std::string(usage)));
+        return out;
+    }
+
+    size_t count = 0;
+    for (auto element : params) {
+        simdjson::ondemand::value value;
+        simdjson::ondemand::json_type type{};
+        if (element.get(value) != simdjson::SUCCESS || value.type().get(type) != simdjson::SUCCESS) {
+            fail(make_error(error_code::misc_error, std::string(usage)));
+            return out;
+        }
+        ++count;
+        if (count == 1) {
+            std::string_view action;
+            if (type != simdjson::ondemand::json_type::string) {
+                fail(type_error("string", type));
+                continue;
+            }
+            if (value.get_string().get(action) != simdjson::SUCCESS) {
+                fail(make_error(error_code::misc_error, std::string(usage)));
+                return out;
+            }
+            out.action.assign(action);
+            continue;
+        }
+        if (count > 2) {
+            break;
+        }
+        out.has_objects = true;
+        simdjson::ondemand::array objects;
+        if (type != simdjson::ondemand::json_type::array ||
+            value.get_array().get(objects) != simdjson::SUCCESS) {
+            fail(type_error("array", type));
+            continue;
+        }
+        out.objects.reserve(std::min<size_t>(max_scan_objects, 64));
+        for (auto entry : objects) {
+            if (out.objects.size() == max_scan_objects) {
+                out.too_many = true;
+                break;
+            }
+            simdjson::ondemand::value object;
+            simdjson::ondemand::json_type kind{};
+            scan_object read;
+            if (entry.get(object) != simdjson::SUCCESS || object.type().get(kind) != simdjson::SUCCESS) {
+                read.error = make_error(error_code::misc_error, std::string(usage));
+            } else if (kind == simdjson::ondemand::json_type::string) {
+                std::string_view raw;
+                if (object.raw_json().get(raw) != simdjson::SUCCESS ||
+                    ! unescape_json_string(raw, read.text)) {
+                    wipe(read.text);
+                    read.text.push_back('\xff');
+                }
+            } else if (kind == simdjson::ondemand::json_type::object) {
+                simdjson::ondemand::object fields;
+                if (object.get_object().get(fields) != simdjson::SUCCESS) {
+                    read.error = make_error(error_code::misc_error, std::string(usage));
+                } else {
+                    read = read_object(fields);
+                }
+            } else {
+                read.error = make_error(error_code::invalid_parameter,
+                    "Scan object needs to be either a string or an object");
+            }
+            out.objects.push_back(std::move(read));
+        }
+    }
+    if (count < 1 || count > 2) {
+        out.error = make_error(error_code::misc_error, std::string(usage));
+    }
+    return out;
+}
+
+// ---- scan objects -------------------------------------------------------------
+
+constexpr std::string_view unsupported_descriptors[] = {"pk", "pkh", "combo", "multi", "sh"};
+
+rpc_error invalid_descriptor(size_t position, std::string_view reason = {}) {
+    // The position, never the text: an error is read by whoever reads the
+    // client's logs, and the text is what the caller looks for.
+    return make_error(error_code::invalid_address_or_key, reason.empty()
+        ? fmt::format("Invalid descriptor in scanobjects[{}]", position)
+        : fmt::format("Invalid descriptor in scanobjects[{}]: {}", position, reason));
+}
+
+// Add what one descriptor looks for to the run, or say why it is not taken.
+std::optional<rpc_error> add_scan_object(size_t position, std::string_view text,
+                                         domain::config::network net, scan_run& run) {
+    auto const open = text.find('(');
+    if (open == std::string_view::npos || open == 0 || text.back() != ')') {
+        return invalid_descriptor(position);
+    }
+    auto const name = text.substr(0, open);
+    auto const inner = text.substr(open + 1, text.size() - open - 2);
+
+    if (std::ranges::find(unsupported_descriptors, name) != std::end(unsupported_descriptors)) {
+        return invalid_descriptor(position,
+            "kth scans for addr(), raw() and tok() objects, not pk(), pkh(), combo(), multi() or sh()");
+    }
+
+    if (name == "raw") {
+        if (inner.empty() || inner.size() % 2 != 0) {
+            return invalid_descriptor(position);
+        }
+        if (inner.size() / 2 > max_raw_script_size) {
+            return invalid_descriptor(position, fmt::format(
+                "a raw() script is at most {} bytes", max_raw_script_size));
+        }
+        wiped_bytes script(inner.size() / 2);
+        auto const decoded = decode_base16(inner, std::span<uint8_t>(script));
+        if ( ! decoded || *decoded != script.size()) {
+            return invalid_descriptor(position);
+        }
+        run.scripts.insert(std::move(script));
+        return std::nullopt;
+    }
+
+    if (name == "addr") {
+        std::array<uint8_t, max_address_script_size> script{};
+        detail::scope_action wipe_script([&script]() noexcept {
+            wipe(script.data(), script.size());
+        }, true);
+        auto const size = address_output_script(inner, net, script);
+        if ( ! size) {
+            return invalid_descriptor(position);
+        }
+        run.scripts.insert(wiped_bytes(script.begin(), script.begin() + *size));
+        return std::nullopt;
+    }
+
+    if (name == "tok") {
+        // BCHN's tok(<category>): 64 hex digits, the category in display order.
+        if (inner.size() != 64) {
+            return invalid_descriptor(position);
+        }
+        auto category = decode_hash(inner);
+        if ( ! category) {
+            return invalid_descriptor(position);
+        }
+        run.categories.insert(*category);
+        wipe(category->data(), category->size());
+        return std::nullopt;
+    }
+
+    return invalid_descriptor(position);
+}
+
+// ---- the walk -------------------------------------------------------------------
+
+// The parts of a stored output a scan reads, in place: its value, its locking
+// bytecode, and its token prefix (the 0xef byte and what follows it, up to the
+// locking bytecode) when it has token data. An output whose prefix does not
+// decode keeps it as locking bytecode, as the output's own parser does.
+struct stored_output {
+    uint64_t value;
+    std::span<uint8_t const> locking;
+    std::span<uint8_t const> token;
+    size_t wrapped_size;
+};
+
+std::optional<stored_output> read_stored_output(std::span<uint8_t const> stored,
+    std::optional<domain::chain::token_data_t>* token_out = nullptr) {
+    byte_reader reader(stored);
+    auto const value = reader.read_little_endian<uint64_t>();
+    if ( ! value) {
+        return std::nullopt;
+    }
+    auto const size = reader.read_size_little_endian();
+    if ( ! size) {
+        return std::nullopt;
+    }
+    auto const wrapped = reader.read_bytes(*size);
+    if ( ! wrapped) {
+        return std::nullopt;
+    }
+    stored_output out{*value, *wrapped, {}, wrapped->size()};
+    if ( ! wrapped->empty() && wrapped->front() == domain::chain::encoding::PREFIX_BYTE) {
+        byte_reader token_reader(wrapped->subspan(1));
+        auto token = domain::chain::token::encoding::from_data(token_reader);
+        if (token) {
+            auto const prefix = wrapped->size() - token_reader.remaining_size();
+            out.token = wrapped->first(prefix);
+            out.locking = wrapped->subspan(prefix);
+            if (token_out != nullptr) {
+                token_out->emplace(std::move(*token));
+            }
+        }
+    }
+    return out;
+}
+
+// An upper bound of what one output adds to the answer: its object in
+// "unspents" and its line in "token_total_amounts". The hex of the locking
+// bytecode and of a commitment are twice their bytes, and both are inside
+// the wrapped script; everything else is under 512 bytes.
+constexpr size_t answer_size_bound(size_t wrapped_size) noexcept {
+    return 512 + 2 * wrapped_size;
+}
+
+[[maybe_unused]]
+void consider(scan_run& run, utxoz::raw_outpoint const& key, uint32_t height,
+              std::span<uint8_t const> stored) {
+    std::optional<domain::chain::token_data_t> token;
+    auto const output = read_stored_output(stored, run.categories.empty() ? nullptr : &token);
+    if ( ! output) {
+        return;
+    }
+    auto const found = run.scripts.contains(output->locking) ||
+        (token && run.categories.contains(token->id));
+    if ( ! found) {
+        return;
+    }
+    auto const bound = answer_size_bound(output->wrapped_size);
+    if (run.answer_bound + bound > max_scan_answer_size) {
+        run.too_large = true;
+        return;
+    }
+    run.answer_bound += bound;
+    run.longest_text = std::max(run.longest_text, 2 * output->wrapped_size);
+    run.matches.push_back(scan_run::match{key, height, wiped_bytes(stored.begin(), stored.end())});
+}
+
+// Walk until a pass completes or the scan is stopped. A pass that gives way to
+// block connection is started again from the beginning: what it found is
+// dropped and the gate admits the walk again once the block is connected.
+void walk(blockchain::block_chain const& chain, scan_run& run, std::stop_token const& stop) {
+#if defined(KTH_UTXOZ_REFERENCE_MODE)
+    (void)chain;
+    (void)stop;
+    run.ending = scan_run::end::unreadable;
+#else
+    auto const stopping = [&] {
+        return stop.stop_requested() || run.abort.load(std::memory_order_relaxed) || run.too_large;
+    };
+    for (;;) {
+        // What an earlier pass found goes, zeroed by the allocator.
+        decltype(run.matches){}.swap(run.matches);
+        run.searched = 0;
+        run.answer_bound = 0;
+        run.progress.store(0, std::memory_order_relaxed);
+        if (stopping()) {
+            run.ending = run.too_large ? scan_run::end::too_large : scan_run::end::aborted;
+            return;
+        }
+        auto const counted = chain.utxo_count();
+        uint64_t const total = counted ? uint64_t(*counted) : 0;
+        // Asked again: the count waits in the gate behind a block, and the
+        // scan may have been aborted meanwhile.
+        if (stopping()) {
+            run.ending = scan_run::end::aborted;
+            return;
+        }
+        auto visit = [&](utxoz::raw_outpoint const& key, uint32_t height,
+                         std::span<uint8_t const> stored) {
+            ++run.searched;
+            if (total != 0 && (run.searched & 0xff) == 0) {
+                run.progress.store(int(std::min<uint64_t>(99, run.searched * 100 / total)),
+                    std::memory_order_relaxed);
+            }
+            consider(run, key, height, stored);
+        };
+        auto const ended = chain.utxo_walk_entries(visit, stopping);
+        using walk_end = blockchain::block_chain::utxo_walk_end;
+        switch (ended) {
+            case walk_end::complete:
+                run.progress.store(100, std::memory_order_relaxed);
+                run.ending = scan_run::end::complete;
+                return;
+            case walk_end::yielded:
+                ++run.passes;
+                continue;
+            case walk_end::stopped:
+                run.ending = run.too_large ? scan_run::end::too_large : scan_run::end::aborted;
+                return;
+            case walk_end::unreadable:
+                run.ending = scan_run::end::unreadable;
+                return;
+        }
+    }
+#endif
+}
+
+// ---- the answer -----------------------------------------------------------------
+
+void wipe_token(domain::chain::token_data_t& token) noexcept {
+    wipe(token.id.data(), token.id.size());
+    std::visit([](auto& kind) {
+        using kind_t = std::decay_t<decltype(kind)>;
+        if constexpr (std::is_same_v<kind_t, domain::chain::non_fungible>) {
+            wipe(kind.commitment);
+        } else if constexpr (std::is_same_v<kind_t, domain::chain::both_kinds>) {
+            wipe(kind.non_fungible_part.commitment);
+        }
+    }, token.data);
+}
+
+bool outpoint_less(utxoz::raw_outpoint const& a, utxoz::raw_outpoint const& b) noexcept {
+    // BCHN's order: the txid's bytes as stored, then the index as a number.
+    if (auto const order = std::memcmp(a.data(), b.data(), 32); order != 0) {
+        return order < 0;
+    }
+    uint32_t ia = 0;
+    uint32_t ib = 0;
+    for (size_t i = 0; i < 4; ++i) {
+        ia |= uint32_t(a[32 + i]) << (8 * i);
+        ib |= uint32_t(b[32 + i]) << (8 * i);
+    }
+    return ia < ib;
+}
+
+// The answer, as BCHN 29.1.0 gives it. Every string formatted on the way is
+// wiped, and the writer is sized so that it never grows.
+void render(scan_run& run) {
+    std::vector<uint32_t, wiping_allocator<uint32_t>> order(run.matches.size());
+    std::iota(order.begin(), order.end(), uint32_t{0});
+    std::ranges::sort(order, [&run](uint32_t a, uint32_t b) {
+        return outpoint_less(run.matches[a].key, run.matches[b].key);
+    });
+
+    using totals_map = boost::unordered_flat_map<hash_digest, int64_t, scan_run::category_hash,
+        std::equal_to<>, wiping_allocator<std::pair<hash_digest const, int64_t>>>;
+    totals_map totals;
+    uint64_t total = 0;
+
+    writer w(run.answer_bound + 6 * run.longest_text + 4096);
+    w.begin_object();
+    w.field("success", run.ending == scan_run::end::complete);
+    w.field("searched_items", uint64_t(run.searched));
+    w.key("unspents").begin_array();
+    for (auto const index : order) {
+        auto const& found = run.matches[index];
+        std::optional<domain::chain::token_data_t> token;
+        auto const output = read_stored_output(found.stored, &token);
+        if ( ! output) {
+            continue;
+        }
+        w.begin_object();
+        hash_digest txid;
+        std::copy_n(found.key.begin(), txid.size(), txid.begin());
+        auto txid_text = encode_hash(txid);
+        w.field("txid", txid_text);
+        wipe(txid_text);
+        wipe(txid.data(), txid.size());
+        uint32_t vout = 0;
+        for (size_t i = 0; i < 4; ++i) {
+            vout |= uint32_t(found.key[32 + i]) << (8 * i);
+        }
+        w.field("vout", uint64_t(vout));
+        auto script_text = encode_base16(output->locking);
+        w.field("scriptPubKey", script_text);
+        wipe(script_text);
+        auto amount = satoshi_to_bitcoin(output->value);
+        w.field_raw("amount", amount);
+        wipe(amount);
+        w.field("height", uint64_t(found.height));
+        if (token) {
+            write_token_data(w, *token);
+            // As BCHN: the fungible amounts by category, an addition that
+            // would pass INT64_MAX left out.
+            if (auto const fungible = domain::chain::get_amount(*token); fungible > 0) {
+                auto& sum = totals[token->id];
+                if (sum <= std::numeric_limits<int64_t>::max() - fungible) {
+                    sum += fungible;
+                }
+            }
+            wipe_token(*token);
+        }
+        w.end_object();
+        total += output->value;
+    }
+    w.end_array();
+    auto total_text = satoshi_to_bitcoin(total);
+    w.field_raw("total_amount", total_text);
+    wipe(total_text);
+    if ( ! totals.empty()) {
+        // Ordered as BCHN orders them: by the category's bytes as stored.
+        std::vector<std::pair<hash_digest, int64_t>,
+            wiping_allocator<std::pair<hash_digest, int64_t>>> sorted(totals.begin(), totals.end());
+        std::ranges::sort(sorted, [](auto const& a, auto const& b) {
+            return std::memcmp(a.first.data(), b.first.data(), a.first.size()) < 0;
+        });
+        w.key("token_total_amounts").begin_object();
+        for (auto const& [category, sum] : sorted) {
+            auto category_text = encode_hash(category);
+            auto sum_text = std::to_string(sum);
+            w.key(category_text);
+            w.value(std::string_view(sum_text));
+            wipe(category_text);
+            wipe(sum_text);
+        }
+        w.end_object();
+    }
+    w.end_object();
+    run.answer = w.str();
+    run.answer_grown = w.grown();
+    w.wipe();
+    if (run.answer_grown) {
+        // A bound that was not one; what was found is not named.
+        spdlog::warn("[rpc] scantxoutset outgrew the buffer sized for its answer");
+    }
+}
+
+void run_scan(blockchain::block_chain const& chain, scan_run& run, std::stop_token stop) noexcept {
+    try {
+        walk(chain, run, stop);
+        if (run.ending == scan_run::end::complete || run.ending == scan_run::end::aborted) {
+            render(run);
+        }
+    } catch (...) {
+        run.ending = scan_run::end::unreadable;
+        wipe(run.answer);
+    }
+    (void)run.done.try_send(std::monostate{});
+}
+
+constexpr std::string_view off_message =
+    "scantxoutset is off on this node; the node operator turns it on with rpc.scantxoutset = true";
+constexpr std::string_view caller_message =
+    "scantxoutset answers callers on loopback and those named in rpc.scantxoutset_caller, "
+    "and this caller is not one of them";
+
+} // namespace
+
+// ---- access -----------------------------------------------------------------------
+
+namespace {
+
+::asio::ip::address normalized(::asio::ip::address const& address) {
+    if (address.is_v6() && address.to_v6().is_v4_mapped()) {
+        return ::asio::ip::make_address_v4(::asio::ip::v4_mapped, address.to_v6());
+    }
+    return address;
+}
+
+} // namespace
+
+scan_access make_scan_access(rpc_settings const& settings) {
+    scan_access access;
+    access.enabled = settings.scantxoutset;
+    for (auto const& text : settings.scantxoutset_callers) {
+        auto const address = scantxoutset_caller_address(text);
+        if ( ! address) {
+            spdlog::error("[rpc] An entry of rpc.scantxoutset_caller {}; scantxoutset stays off",
+                address.error());
+            return {};
+        }
+        access.callers.push_back(*address);
+    }
+    return access;
+}
+
+bool scan_caller_allowed(scan_access const& access, std::optional<::asio::ip::address> const& peer) {
+    if ( ! peer) {
+        return false;
+    }
+    auto const address = normalized(*peer);
+    if (address.is_loopback()) {
+        return true;
+    }
+    return std::ranges::find(access.callers, address) != access.callers.end();
+}
+
+// ---- addresses --------------------------------------------------------------------
+
+namespace {
+
+#if defined(KTH_CURRENCY_BCH)
+constexpr std::string_view cashaddr_charset = "qpzry9x8gf2tvdw0s3jn54khce6mua7l";
+
+constexpr int cashaddr_value(char c) noexcept {
+    if (c >= 'A' && c <= 'Z') {
+        c = char(c - 'A' + 'a');
+    }
+    auto const at = cashaddr_charset.find(c);
+    return at == std::string_view::npos ? -1 : int(at);
+}
+
+constexpr uint64_t cashaddr_step(uint64_t chk, uint8_t value) noexcept {
+    auto const top = uint8_t(chk >> 35);
+    chk = ((chk & 0x07ffffffffULL) << 5) ^ value;
+    if (top & 0x01) chk ^= 0x98f2bc8e61ULL;
+    if (top & 0x02) chk ^= 0x79b76d99e2ULL;
+    if (top & 0x04) chk ^= 0xf33e5fb3c4ULL;
+    if (top & 0x08) chk ^= 0xae2eabe2a8ULL;
+    if (top & 0x10) chk ^= 0x1e4f43e470ULL;
+    return chk;
+}
+
+// The cashaddr longest address this decodes: a 64-byte hash, its version, and
+// the checksum, in 5-bit groups.
+constexpr size_t max_cashaddr_groups = (65 * 8 + 4) / 5 + 8;
+
+// A cashaddr of `prefix`, as BCHN's cashaddr::Decode and DecodeCashAddrContent
+// take one: one case throughout, an optional prefix of letters, the checksum,
+// zero padding, the version's reserved bit clear and the hash of the size the
+// version gives. The type and the hash, in `hash`, or nullopt. Fixed buffers
+// only, which the caller wipes.
+struct cashaddr_content {
+    uint8_t type;
+    size_t hash_size;
+};
+
+std::optional<cashaddr_content> decode_cashaddr(std::string_view text, std::string_view prefix,
+    std::span<uint8_t, 64> hash, std::span<uint8_t, max_cashaddr_groups> groups) noexcept {
+    bool lower = false;
+    bool upper = false;
+    bool number = false;
+    size_t separator = std::string_view::npos;
+    for (size_t i = 0; i < text.size(); ++i) {
+        auto const c = text[i];
+        if (c >= 'a' && c <= 'z') { lower = true; continue; }
+        if (c >= 'A' && c <= 'Z') { upper = true; continue; }
+        if (c >= '0' && c <= '9') { number = true; continue; }
+        if (c == ':' && ! number && i != 0 && separator == std::string_view::npos) {
+            separator = i;
+            continue;
+        }
+        return std::nullopt;
+    }
+    if (lower && upper) {
+        return std::nullopt;
+    }
+
+    auto payload = text;
+    if (separator != std::string_view::npos) {
+        auto const given = text.substr(0, separator);
+        if (given.size() != prefix.size()) {
+            return std::nullopt;
+        }
+        for (size_t i = 0; i < given.size(); ++i) {
+            auto c = given[i];
+            if (c >= 'A' && c <= 'Z') {
+                c = char(c - 'A' + 'a');
+            }
+            if (c != prefix[i]) {
+                return std::nullopt;
+            }
+        }
+        payload = text.substr(separator + 1);
+    }
+    if (payload.size() <= 8 || payload.size() > groups.size()) {
+        return std::nullopt;
+    }
+
+    uint64_t chk = 1;
+    for (auto const c : prefix) {
+        chk = cashaddr_step(chk, uint8_t(c) & 0x1f);
+    }
+    chk = cashaddr_step(chk, 0);
+    for (size_t i = 0; i < payload.size(); ++i) {
+        auto const value = cashaddr_value(payload[i]);
+        if (value < 0) {
+            return std::nullopt;
+        }
+        groups[i] = uint8_t(value);
+        chk = cashaddr_step(chk, groups[i]);
+    }
+    if ((chk ^ 1) != 0) {
+        return std::nullopt;
+    }
+
+    // 5-bit groups to bytes, the version first, with no more than four bits
+    // of padding and those zero.
+    auto const data_groups = payload.size() - 8;
+    std::array<uint8_t, 65> bytes{};
+    detail::scope_action wipe_bytes([&bytes]() noexcept {
+        wipe(bytes.data(), bytes.size());
+    }, true);
+    size_t produced = 0;
+    uint32_t acc = 0;
+    size_t bits = 0;
+    for (size_t i = 0; i < data_groups; ++i) {
+        acc = ((acc << 5) | groups[i]) & 0xfff;
+        bits += 5;
+        while (bits >= 8) {
+            bits -= 8;
+            if (produced == bytes.size()) {
+                return std::nullopt;
+            }
+            bytes[produced++] = uint8_t((acc >> bits) & 0xff);
+        }
+    }
+    if (bits >= 5 || ((acc << (8 - bits)) & 0xff) != 0) {
+        return std::nullopt;
+    }
+    if (produced == 0) {
+        return std::nullopt;
+    }
+    auto const version = bytes[0];
+    if ((version & 0x80) != 0) {
+        return std::nullopt;
+    }
+    size_t hash_size = 20 + 4 * (version & 0x03);
+    if ((version & 0x04) != 0) {
+        hash_size *= 2;
+    }
+    if (produced != hash_size + 1) {
+        return std::nullopt;
+    }
+    std::copy_n(bytes.begin() + 1, hash_size, hash.begin());
+    return cashaddr_content{uint8_t((version >> 3) & 0x1f), hash_size};
+}
+#endif
+
+} // namespace
+
+std::optional<size_t> address_output_script(std::string_view address, domain::config::network net,
+    std::span<uint8_t, max_address_script_size> script) noexcept {
+    using domain::wallet::payment_address;
+    auto const mainnet = net == domain::config::network::mainnet;
+    auto const p2kh = mainnet ? payment_address::mainnet_p2kh : payment_address::testnet_p2kh;
+    auto const p2sh = mainnet ? payment_address::mainnet_p2sh : payment_address::testnet_p2sh;
+
+    auto const pay_to = [&script](bool is_script, std::span<uint8_t const> hash) -> std::optional<size_t> {
+        if (hash.size() == 20 && ! is_script) {
+            // OP_DUP OP_HASH160 <20> OP_EQUALVERIFY OP_CHECKSIG
+            script[0] = 0x76;
+            script[1] = 0xa9;
+            script[2] = 0x14;
+            std::copy_n(hash.begin(), 20, script.begin() + 3);
+            script[23] = 0x88;
+            script[24] = 0xac;
+            return 25;
+        }
+        if (hash.size() == 20) {
+            // OP_HASH160 <20> OP_EQUAL
+            script[0] = 0xa9;
+            script[1] = 0x14;
+            std::copy_n(hash.begin(), 20, script.begin() + 2);
+            script[22] = 0x87;
+            return 23;
+        }
+        if (hash.size() == 32 && is_script) {
+            // OP_HASH256 <32> OP_EQUAL
+            script[0] = 0xaa;
+            script[1] = 0x20;
+            std::copy_n(hash.begin(), 32, script.begin() + 2);
+            script[34] = 0x87;
+            return 35;
+        }
+        return std::nullopt;
+    };
+
+#if defined(KTH_CURRENCY_BCH)
+    {
+        std::array<uint8_t, 64> hash{};
+        std::array<uint8_t, max_cashaddr_groups> groups{};
+        detail::scope_action wipe_buffers([&hash, &groups]() noexcept {
+            wipe(hash.data(), hash.size());
+            wipe(groups.data(), groups.size());
+        }, true);
+        auto const content = decode_cashaddr(address, payment_address::cashaddr_prefix_for(net),
+            hash, groups);
+        // Types 0 and 2 pay to a key hash, 1 and 3 to a script hash; 2 and 3
+        // are the token-aware forms of the same outputs. Any other cashaddr
+        // is no destination, and the text is tried as a legacy address, as
+        // BCHN tries it.
+        if (content && content->type <= 3) {
+            auto const is_script = (content->type & 0x01) != 0;
+            if (auto const size = pay_to(is_script,
+                    std::span<uint8_t const>(hash.data(), content->hash_size))) {
+                return size;
+            }
+        }
+    }
+#endif
+
+    // A legacy address of this network: version, 20-byte hash and checksum.
+    auto decoded = decode_base58<domain::wallet::payment_size>(address);
+    if ( ! decoded) {
+        return std::nullopt;
+    }
+    detail::scope_action wipe_decoded([&decoded]() noexcept {
+        wipe(decoded->data(), decoded->size());
+    }, true);
+    auto const parsed = payment_address::from_payment(*decoded);
+    if ( ! parsed || (parsed->version() != p2kh && parsed->version() != p2sh)) {
+        return std::nullopt;
+    }
+    std::array<uint8_t, 20> hash{};
+    detail::scope_action wipe_hash([&hash]() noexcept {
+        wipe(hash.data(), hash.size());
+    }, true);
+    std::copy_n(decoded->begin() + 1, hash.size(), hash.begin());
+    return pay_to(parsed->version() == p2sh, hash);
+}
