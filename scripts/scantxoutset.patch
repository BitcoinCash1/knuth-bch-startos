+// Start the server on `bind` with a port the system assigns, ask it one
+// scantxoutset status over loopback, and stop it. What it logged, and the
+// answer.
+std::pair<std::vector<std::string>, std::string> serve_once(char const* tag, std::string bind,
+                                                             bool on, std::vector<std::string> callers) {
+    test::chain_fixture chain(tag);
+    REQUIRE(chain.created());
+    REQUIRE(chain.start());
+    node::rpc_settings settings;
+    settings.bind = std::move(bind);
+    settings.port = 0;
+    settings.user = "test";
+    settings.password = "test";
+    settings.scantxoutset = on;
+    settings.scantxoutset_callers = std::move(callers);
+
+    captured_log log;
+    std::string reply;
+    {
+        ::asio::io_context io;
+        rpc::server server(settings, chain.chain(), io.get_executor());
+        auto ran = ::asio::co_spawn(io, server.run(), ::asio::use_future);
+        auto listening = ::asio::co_spawn(io, server.wait_until_listening(), ::asio::use_future);
+        std::thread runner([&io] { io.run(); });
+        REQUIRE(listening.wait_for(std::chrono::seconds(10)) == std::future_status::ready);
+        auto const port = listening.get();
+
+        auto const body = std::string(R"({"method":"scantxoutset","params":["status"],"id":1})");
+        auto const request = "POST / HTTP/1.1\r\nHost: 127.0.0.1\r\nAuthorization: Basic dGVzdDp0ZXN0\r\n"
+            "Connection: close\r\nContent-Length: " + std::to_string(body.size()) + "\r\n\r\n" + body;
+        ::asio::io_context client;
+        ::asio::ip::tcp::socket socket(client);
+        socket.connect({::asio::ip::make_address("127.0.0.1"), port});
+        ::asio::write(socket, ::asio::buffer(request));
+        socket.shutdown(::asio::ip::tcp::socket::shutdown_send);
+        std::error_code ec;
+        ::asio::read(socket, ::asio::dynamic_buffer(reply), ec);
+
+        server.stop();
+        runner.join();
+        ran.get();
+    }
+    return {log.sink->last_formatted(), reply.substr(reply.find("\r\n\r\n") + 4)};
+}
+
+bool holds(std::vector<std::string> const& lines, std::string_view text) {
+    return std::ranges::any_of(lines, [text](std::string const& line) {
+        return line.find(text) != std::string::npos;
+    });
+}
