+    CHECK(f.call(R"(["start",["raw(5)"]])") == invalid(0));
+    CHECK(f.call(R"(["start",["raw()"]])") == invalid(0));
+    CHECK(f.call(R"(["start",["raw(51)x"]])") == invalid(0));
+    CHECK(f.call(R"(["start",["raw(51))"]])") == invalid(0));
