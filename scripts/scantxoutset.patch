+TEST_CASE("scantxoutset answers status and abort while its walk waits for a block", "[rpc scan]") {
+    scan_fixture f("rpc_scan_status");
+    REQUIRE(f.start());
+    store(f.chain.chain(), sample_set());
+
+    ::asio::io_context io;
+    auto work = ::asio::make_work_guard(io);
+    std::thread runner([&io] { io.run(); });
+    auto ctx = f.context();
+    auto other = f.context();
+    auto const start = std::string(R"({"method":"scantxoutset","params":["start",["raw(51)"]],"id":1})");
+    auto const status = std::string(R"({"method":"scantxoutset","params":["status"],"id":1})");
+    auto const abort = std::string(R"({"method":"scantxoutset","params":["abort"],"id":1})");
+    auto const handle = [&](rpc::method_context& context, std::string const& body) {
+        return ::asio::co_spawn(io, f.dispatcher.handle(context, body), ::asio::use_future);
+    };
+
+    std::future<std::string> started;
+    {
+        // The window a connect batch holds: the walk waits in the gate for it.
+        auto window = f.chain.chain().begin_utxo_write();
+        REQUIRE(window);
+        started = handle(ctx, start);
+        CHECK(handle(other, status).get() == rpc::build_success("1", R"({"progress":0})"));
+        CHECK(handle(other, start).get() ==
+            refusal(-8, "Scan already in progress, use action \"abort\" or \"status\""));
+        CHECK(started.wait_for(std::chrono::milliseconds(50)) == std::future_status::timeout);
+        CHECK(handle(other, abort).get() == rpc::build_success("1", "true"));
+    }
+    REQUIRE(started.wait_for(std::chrono::seconds(30)) == std::future_status::ready);
+    CHECK(started.get() == answer(0, {}, "0", {}, /*success*/ false));
+    // The scan is over.
+    CHECK(handle(other, status).get() == rpc::build_success("1", "null"));
+    CHECK(handle(other, abort).get() == rpc::build_success("1", "false"));
+    work.reset();
+    runner.join();
+}
