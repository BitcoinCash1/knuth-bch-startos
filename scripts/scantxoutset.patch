+TEST_CASE("a walk of the UTXO set gives way to a writer and leaves it the window", "[rpc scan]") {
+    scan_fixture f("rpc_scan_walk_yields");
+    REQUIRE(f.start());
+    std::vector<unspent> set;
+    for (uint32_t i = 0; i < 3000; ++i) {
+        hash_digest txid{};
+        txid[0] = uint8_t(i);
+        txid[1] = uint8_t(i >> 8);
+        set.push_back({txid, 0, output_of(1000, true_script), 2});
+    }
+    store(f.chain.chain(), set);
+    auto& chain = f.chain.chain();
+    using walk_end = blockchain::block_chain::utxo_walk_end;
+
+    // A writer asks for the window ten entries in. The walk sees it at its
+    // next check, after 1024 entries, and stops there.
+    std::thread writer;
+    std::atomic<bool> admitted{false};
+    size_t visited = 0;
+    auto const ended = chain.utxo_walk_entries([&](utxoz::raw_outpoint const&, uint32_t,
+                                                   std::span<uint8_t const>) {
+        if (++visited == 10) {
+            writer = std::thread([&chain, &admitted] {
+                auto window = chain.begin_utxo_write();
+                admitted = window.has_value();
+            });
+            auto const deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+            while ( ! chain.utxo_writer_waiting() && std::chrono::steady_clock::now() < deadline) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+        }
+    }, [] { return false; });
+    writer.join();
+    CHECK(ended == walk_end::yielded);
+    CHECK(visited == 1023);
+    CHECK(admitted);
+
+    // With no writer, the whole set; stopped when asked.
+    size_t again = 0;
+    CHECK(chain.utxo_walk_entries([&again](utxoz::raw_outpoint const&, uint32_t, std::span<uint8_t const>) {
+        ++again;
+    }, [] { return false; }) == walk_end::complete);
+    CHECK(again == f.set_size());
+    CHECK(chain.utxo_walk_entries([](utxoz::raw_outpoint const&, uint32_t, std::span<uint8_t const>) {},
+        [] { return true; }) == walk_end::stopped);
+}
