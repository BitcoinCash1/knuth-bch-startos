+
+std::string answer(uint64_t searched, std::vector<std::string> const& unspents, std::string_view total,
+                   std::string_view token_totals = {}, bool success = true) {
+    std::string listed;
+    for (auto const& item : unspents) {
+        listed += (listed.empty() ? "" : ",") + item;
+    }
+    auto result = fmt::format(R"({{"success":{},"searched_items":{},"unspents":[{}],"total_amount":{})",
+        success ? "true" : "false", searched, listed, total);
+    if ( ! token_totals.empty()) {
+        result += fmt::format(R"(,"token_total_amounts":{{{}}})", token_totals);
+    }
+    return rpc::build_success("1", result + "}");
+}
+
+std::string refusal(int code, std::string_view message) {
+    return rpc::build_error("1", code, message);
+}
+
+// What a captured log holds, at every level.
+struct captured_log {
+    captured_log()
+        : sink(std::make_shared<spdlog::sinks::ringbuffer_sink_mt>(4096))
+        , previous(spdlog::default_logger()) {
+        auto logger = std::make_shared<spdlog::logger>("captured", sink);
+        logger->set_level(spdlog::level::trace);
+        spdlog::set_default_logger(logger);
+    }
+
+    ~captured_log() {
+        spdlog::set_default_logger(previous);
+    }
+
+    [[nodiscard]] bool holds(std::string_view text) const {
+        auto const lines = sink->last_formatted();
+        return std::ranges::any_of(lines, [text](std::string const& line) {
+            return line.find(text) != std::string::npos;
+        });
+    }
+
+    std::shared_ptr<spdlog::sinks::ringbuffer_sink_mt> sink;
+    std::shared_ptr<spdlog::logger> previous;
+};
