+// By default (node.input_prefix_filters alone) the input prefix filter is
+// built from its block when asked and nothing is kept for it; its filter
+// headers are kept, and served, only with node.input_prefix_filter_headers.
+
+TEST_CASE("input prefix filter built when asked keeps no records and answers no filter headers by default",
+    "[compact filters][input prefix][index]") {
+    filtered_chain c("ipf_on_demand", 108, 108, 101);
+    auto const dir = std::filesystem::temp_directory_path() / ("kth_ipf_dir_on_demand_" + std::to_string(process_id()));
+    std::error_code ec;
+    std::filesystem::remove_all(dir, ec);
+    std::filesystem::create_directories(dir, ec);
+
+    // What the index of a node keeps, by mode.
+    auto const files = compact_filter_index_files(dir, false);
+    REQUIRE(files.size() == 1);
+    CHECK(files[0].filter_type == regular_type);
+    CHECK(files[0].path.string() == (dir / "compact_filter_headers").string());
+    auto const with_headers = compact_filter_index_files(dir, true);
+    REQUIRE(with_headers.size() == 2);
+    CHECK(with_headers[0].filter_type == regular_type);
+    CHECK(with_headers[1].filter_type == input_prefix_type);
+    CHECK(with_headers[1].path.string() == (dir / "input_prefix_filter_headers").string());
+
+    auto const regular = records_of(c, 108);
+    with_index_of(c, files, pace_of(256), [&](compact_filter_channels& channels) -> ::asio::awaitable<void> {
+        // The regular filter, from its records.
+        auto const answered = co_await ask_compact_filter_headers(channels, headers_request(0, c.hash(108)));
+        REQUIRE(answered);
+        CHECK(answered->filter_hashes == filter_hashes(regular, 0, 108));
+        CHECK(co_await ask_compact_filter_checkpoint(channels, checkpoint_request(c.hash(108))));
+        // No filter headers of the input prefix filter, as for a type the
+        // node does not serve.
+        CHECK( ! co_await ask_compact_filter_headers(channels, headers_request(0, c.hash(108), input_prefix_type)));
+        CHECK( ! co_await ask_compact_filter_headers(channels,
+            headers_request(108, c.hash(108), input_prefix_type)));
+        CHECK( ! co_await ask_compact_filter_checkpoint(channels, checkpoint_request(c.hash(108), input_prefix_type)));
+    });
+
+    // Its filters are built from their blocks when asked.
+    auto const blocks = c.blocks(true);
+    CHECK(blocks.serves(input_prefix_type));
+    for (size_t const height : {size_t(0), size_t(100), size_t(101), size_t(108)}) {
+        CAPTURE(height);
+        auto const filter = run_on_own_context(build_compact_filter(blocks, input_prefix_type, c.hash(height)));
+        REQUIRE(filter);
+        CHECK(*filter == filter_of(c.block(height), input_prefix_type));
+    }
+
+    // Nothing of it in the directory: the file of the regular filter alone.
+    CHECK( ! std::filesystem::exists(dir / "input_prefix_filter_headers"));
+    size_t entries = 0;
+    for (auto const& entry : std::filesystem::directory_iterator(dir)) {
+        CHECK(entry.path().filename().string() == "compact_filter_headers");
+        ++entries;
+    }
+    CHECK(entries == 1);
+    std::filesystem::remove_all(dir, ec);
+}
+
+TEST_CASE("input prefix filter headers follow the setting across runs on one database",
+    "[compact filters][input prefix][index]") {
+    filtered_chain c("ipf_modes", 110, 108, 101);
+    auto const dir = std::filesystem::temp_directory_path() / ("kth_ipf_dir_modes_" + std::to_string(process_id()));
+    std::error_code ec;
+    std::filesystem::remove_all(dir, ec);
+    std::filesystem::create_directories(dir, ec);
+    auto const file = dir / "input_prefix_filter_headers";
+    auto const expected = records_of(c, 110, input_prefix_type);
+
+    // With its filter headers: records kept and answered.
+    with_index_of(c, compact_filter_index_files(dir, true), pace_of(256),
+        [&](compact_filter_channels& channels) -> ::asio::awaitable<void> {
+        auto const whole = co_await ask_compact_filter_headers(channels,
+            headers_request(0, c.hash(108), input_prefix_type));
+        REQUIRE(whole);
+        CHECK(whole->filter_hashes == filter_hashes(expected, 0, 108));
+    });
+    REQUIRE(stored_in(file).size() == 109);
+    auto const kept = bytes_of(file);
+
+    // Then without, two blocks connected meanwhile: no filter headers of the
+    // input prefix filter, and its file neither read nor written.
+    c.connect(109, 110);
+    with_index_of(c, compact_filter_index_files(dir, false), pace_of(256),
+        [&](compact_filter_channels& channels) -> ::asio::awaitable<void> {
+        CHECK(co_await ask_compact_filter_headers(channels, headers_request(0, c.hash(110))));
+        CHECK( ! co_await ask_compact_filter_headers(channels, headers_request(0, c.hash(108), input_prefix_type)));
+        CHECK( ! co_await ask_compact_filter_headers(channels, headers_request(0, c.hash(110), input_prefix_type)));
+        CHECK( ! co_await ask_compact_filter_checkpoint(channels, checkpoint_request(c.hash(110), input_prefix_type)));
+    });
+    CHECK(bytes_of(file) == kept);
+    auto const built = run_on_own_context(build_compact_filter(c.blocks(true), input_prefix_type, c.hash(110)));
+    REQUIRE(built);
+    CHECK(*built == filter_of(c.block(110), input_prefix_type));
+
+    // With them again: the file is taken up where it stopped, to the tip.
+    with_index_of(c, compact_filter_index_files(dir, true), pace_of(256),
+        [&](compact_filter_channels& channels) -> ::asio::awaitable<void> {
+        auto const whole = co_await ask_compact_filter_headers(channels,
+            headers_request(0, c.hash(110), input_prefix_type));
+        REQUIRE(whole);
+        CHECK(whole->filter_hashes == filter_hashes(expected, 0, 110));
+    });
+    auto const store = stored_in(file);
+    REQUIRE(store.size() == 111);
+    CHECK(store.tip() == c.hash(110));
+    for (size_t height = 0; height <= 110; ++height) {
+        CAPTURE(height);
+        CHECK(store.at(height) == expected[height]);
+    }
+    std::filesystem::remove_all(dir, ec);
+}
+
+TEST_CASE("input prefix filter headers are off unless asked for, and need the input prefix filter",
+    "[compact filters][input prefix][parser]") {
+    {
+        node::parser parser(domain::config::network::regtest);
+        char const* argv[]{"kth", "--network", "regtest", "--node.compact_filters", "true",
+            "--node.input_prefix_filters", "true"};
+        std::ostringstream error;
+        REQUIRE(parser.parse(7, argv, error));
+        CHECK(parser.configured.node.input_prefix_filters);
+        CHECK( ! parser.configured.node.input_prefix_filter_headers);
+    }
+    {
+        node::parser parser(domain::config::network::regtest);
+        char const* argv[]{"kth", "--network", "regtest", "--node.compact_filters", "true",
+            "--node.input_prefix_filters", "true", "--node.input_prefix_filter_headers", "true"};
+        std::ostringstream error;
+        REQUIRE(parser.parse(9, argv, error));
+        CHECK(parser.configured.node.input_prefix_filter_headers);
+    }
+    {
+        node::parser parser(domain::config::network::regtest);
+        char const* argv[]{"kth", "--network", "regtest", "--node.compact_filters", "true",
+            "--node.input_prefix_filter_headers", "true"};
+        std::ostringstream error;
+        CHECK( ! parser.parse(7, argv, error));
+        CHECK(error.str().find("node.input_prefix_filter_headers needs node.input_prefix_filters")
+            != std::string::npos);
+    }
+    {
+        node::parser parser(domain::config::network::regtest);
+        char const* argv[]{"kth", "--network", "regtest", "--node.compact_filters", "true",
+            "--node.input_prefix_filters", "true", "--node.input_prefix_filter_headers", "true",
+            "--db.prune_keep_blocks", "288"};
+        std::ostringstream error;
+        CHECK( ! parser.parse(11, argv, error));
+        CHECK(error.str().find("not allowed on a pruning node") != std::string::npos);
+    }
+}
+
 TEST_CASE("the input prefix filter is off unless asked for, needs compact filters, and is refused on a pruning node",
     "[compact filters][input prefix][parser]") {
     {
