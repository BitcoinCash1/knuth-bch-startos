+std::vector<compact_filter_index_file> compact_filter_index_files(kth::path const& directory,
+    bool input_prefix_headers) {
+    std::vector<compact_filter_index_file> files;
+    files.push_back({domain::message::regular_compact_filter, directory / "compact_filter_headers"});
+    if (input_prefix_headers) {
+        files.push_back({domain::message::input_prefix_compact_filter, directory / "input_prefix_filter_headers"});
+    }
+    return files;
+}
