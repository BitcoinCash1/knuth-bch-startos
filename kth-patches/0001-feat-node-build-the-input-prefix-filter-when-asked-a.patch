@@ -161,6 +164,16 @@ struct compact_filter_index_file {
     kth::path path;
 };
 
+// What the index of a node keeps, in its database directory: the records of
+// the regular filter in `compact_filter_headers`, and, with
+// `input_prefix_headers` (node.input_prefix_filter_headers), those of the
