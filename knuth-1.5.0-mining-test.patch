 // getmininginfo -> height, difficulty, mempool size, and network.
@@ -101,19 +105,51 @@ submit_block_light(method_context& ctx, request const& req) {
             "job_id not found or expired"));
     }
 
-    // Reassemble (coinbase followed by the cached selection) and submit.
-    auto const ec = co_await mining::submit_block_light(
-        ctx.chain,
+    // Test build: block_chain::organize(block) is not implemented in 1.5.0
+    // (k-nuth/kth#563), so a solved block is checked here and relayed to the
+    // connected peers, which accept it into the network; this node then syncs
+    // it back like any other block. Nothing is written locally. The checks
+    // keep peers from ever receiving an invalid block from us.
+    auto const block = mining::assemble_block(
         header_and_coinbase->header(),
         header_and_coinbase->transactions().front(),
         *job);
+    auto const reject = [](std::string_view reason) {
+        writer w;
+        w.value(reason);
+        return w.str();
+    };
 
-    writer w;
-    if (ec) {
-        w.value(ec.message()); // BIP22-style reject reason
-    } else {
-        w.value_null();        // accepted
+    auto const view = ctx.chain.chain_view();
+    if ( ! view || ! view->state || ctx.network == nullptr) {
+        co_return reject("inconclusive-not-ready");
+    }
+    auto const& header = block.header();
+    if (header.previous_block_hash() != view->tip_hash) {
+        co_return reject("inconclusive-not-best-prevblk");
+    }
+    auto const height = view->connected_tip_height + 1;
+    if (header.bits() != view->state->get_next_work_required(header.timestamp())) {
+        co_return reject("bad-diffbits");
+    }
+    if (header.timestamp() <= view->state->median_time_past()) {
+        co_return reject("time-too-old");
     }
+    if (auto const ec = block.check(); ec) {
+        co_return reject(ec.message());
+    }
+    if ( ! block.is_valid_coinbase_script(height)) {
+        co_return reject("bad-cb-height");
+    }
+
+    auto const peers = co_await ctx.network->broadcast(block);
+    spdlog::info("[rpc] submitblocklight relayed block {} at height {} to {} peer(s)",
+        encode_hash(domain::chain::hash(header)), height, peers);
+    if (peers == 0) {
+        co_return reject("inconclusive-no-peers");
+    }
+    writer w;
+    w.value_null(); // relayed
     co_return w.str();
 }
 
